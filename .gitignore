# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
# Personal editor preferences only - the checked-in settings this repo needs are none.
.vscode/

# Secrets and signing material - pre-empt the leak, never catch it afterwards.
*.pfx
*.snk
*.jks
*.keystore
*.p12
*.pem
.env
*token*
*secret*
# The glossary term about token budgets is a portal source, not a credential: without it a clone
# cannot rebuild the portal (the pages link to it).
!tools/portal/glossary/token-budget.json

# local zip build staging (the published universal-agent-kit.zip is tracked on purpose)
_uak_build/
# The distributable is tracked deliberately: index.html links it for download and Pages serves this
# tree as-is, so a clone and the published site must carry the exact bytes users get.
!universal-agent-kit.zip

# Scratch, logs and backups live under one tree and never at the repo root.
temp/

# docs/ is local working material, not a published surface (owner decision 2026-10-09):
# the repo ships kit/, the site and the render targets. Files already tracked stay
# tracked until removed by hand. Anchored to the root: kit/docs/ is payload, and an unanchored
# pattern would keep a new kit document out of every clone while the local zip carried it.
/docs/
